EXECUTOR_ADDRESS=
# Confirmed HSKSwap router address; future constructor input (onchain.md section 3).
ROUTER_ADDRESS=
# Confirmed WHSK/USDT pool address (onchain.md section 3).
WHSK_USDT_POOL_ADDRESS=
# Confirmed WETH/USDT pool address (onchain.md section 3).
WETH_USDT_POOL_ADDRESS=
# Deployed vault address for later configuration and verification (onchain.md section 14).
VAULT_ADDRESS=
