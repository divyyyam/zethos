# Encrypted Foundry keystore account name, never a private key. Must be the owner account.
FOUNDRY_ACCOUNT=

# --- Roles. Public addresses only, and three different keys. ---
# Cold. Owns funds and configuration.
OPERATOR_ADDRESS=
# Hot. Signs quotes and nothing else.
QUOTE_SIGNER_ADDRESS=
# Hot. Can pause, and nothing else.
EXECUTOR_ADDRESS=

# --- Testnet only: starting inventory minted to the owner by deploy:test-tokens, in RAW units. ---
# tUSDT has 6 decimals, tWETH has 18. These tokens have no market value.
MINT_TUSDT=
MINT_TWETH=

# --- Tokens. Confirm each one on-chain for the target chain first. ---
# On testnet, USDT and WETH are the addresses deploy:test-tokens prints. Testnet already has WHSK at
# the wrapped-native predeploy, 0x4200000000000000000000000000000000000006.
USDT_ADDRESS=
WHSK_ADDRESS=
WETH_ADDRESS=

# --- Largest input per fill, in RAW units of the token sold. Read decimals on-chain first. ---
# Each must be worth more than the engine's live minimum ($0.50), or that route can never quote.
MAX_IN_USDT_TO_WHSK=
MAX_IN_WHSK_TO_USDT=
MAX_IN_USDT_TO_WETH=
MAX_IN_WETH_TO_USDT=

# --- Optional. Leave these commented out unless you need them. ---
# Confirmed pools for price protection, if a venue with real depth exists.
# WHSK_USDT_POOL_ADDRESS=
# WETH_USDT_POOL_ADDRESS=
# How far below pool spot a fill may land, in bps. Default 100.
# POOL_TOLERANCE_BPS=
# Longest quote the vault accepts, at most 120. Default 120.
# MAX_TTL_SECONDS=

# --- Set after deployment. ---
VAULT_ADDRESS=

# --- Inventory moved into the vault by fund:testnet, in RAW units. Zero skips a token. ---
# Keep these small: the vault is unaudited.
FUND_USDT=
FUND_WHSK=
FUND_WETH=
