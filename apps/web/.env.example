# 177 for HSK mainnet or 133 for testnet; defaults to 177 when blank.
NEXT_PUBLIC_CHAIN_ID=
# REST/WebSocket engine URL, e.g. http://localhost:8787.
NEXT_PUBLIC_ENGINE_URL=
# Public deployed ZethosVault address; never a private key (docs/ui.md section 2.1).
NEXT_PUBLIC_VAULT_ADDRESS=
# Public WalletConnect project ID; blank uses injected wallets for local scaffolding.
NEXT_PUBLIC_WALLETCONNECT_ID=
# Optional RPC override for the selected network. Never put a secret RPC credential here.
NEXT_PUBLIC_RPC_URL=
# Public origin used in WalletConnect metadata; defaults to the browser's current origin.
NEXT_PUBLIC_SITE_URL=
# Confirm deployed token addresses before enabling settlement. Testnet requires all three.
# Mainnet falls back to the candidate addresses in packages/shared/src/constants.ts.
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_WHSK_ADDRESS=
NEXT_PUBLIC_WETH_ADDRESS=
