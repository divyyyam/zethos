# HSK RPC endpoint, mainnet or testnet (required for trading).
HSK_RPC_URL=
# 177 for mainnet or 133 for testnet (required for trading).
CHAIN_ID=
# Deployed ZethosVault address (required for trading).
VAULT_ADDRESS=
# Quote signer hot key, EIP-712 only; never the owner/deployer key.
QUOTE_SIGNER_KEY=
# Separate executor hot key for arbSwap and pause; never the owner/deployer key.
EXECUTOR_KEY=
# Public owner wallet address for operator authorization.
OPERATOR_ADDRESS=
# Gemini API key for the future assistant.
GEMINI_API_KEY=
# Optional Flash-class model; default gemini-3.8-flash.
GEMINI_MODEL=
# SQLite database file path (bun:sqlite; no npm SQLite driver).
DB_PATH=
# Optional live or dry; default live. No agent is started in this scaffold.
ENGINE_MODE=
# Optional true or false; defaults false until baseline recording is ready.
ARB_ENABLED=
# Optional exchange key for P1 hedging.
EXCHANGE_API_KEY=
# Optional exchange secret for P1 hedging.
EXCHANGE_API_SECRET=
# Optional HTTP port; defaults to 8787, including when blank.
PORT=
# Web app origin for future CORS, e.g. http://localhost:3000.
CORS_ORIGIN=
