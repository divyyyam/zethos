PAPER_SIGNER_KEY=

# Optional operator access. The owner and all signing/executor identities must differ.
OPERATOR_ADDRESS=
SESSION_SECRET=

# Natural-English interpretation and asynchronous decision narration. No trading authority.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opt in only for paper development when RPC token metadata is unavailable.
# ERC-20 decimals are otherwise read from chain. Never used for live settlement.
SHADOW_ASSUME_DECIMALS=false

# Bearer token for POST /policies (research-cycle registration). Use a long random value;
# never commit it. Without it, registration fails closed.
ADMIN_TOKEN=

# Neon Postgres connection string. Without it the engine keeps everything in memory.
DATABASE_URL=

# Optional token overrides; required on testnet (CHAIN_ID=133).
USDT_ADDRESS=
WHSK_ADDRESS=
WETH_ADDRESS=

# --- Live mode, HSK testnet only. `bun run dev:live-testnet` sets all of these for you, reading the
# keys from their encrypted keystores, so prefer it to putting keys in this file. ---
# ENGINE_MODE=live
# CHAIN_ID=133
# HSK_RPC_URL=https://testnet.hsk.xyz
# VAULT_ADDRESS=
# QUOTE_SIGNER_KEY=
# EXECUTOR_KEY=
